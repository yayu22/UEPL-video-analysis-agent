# Frontend (Vite) environment. Copy to `.env.local` (git-ignored) to override.

# Backend base URL (the Python API). Use the Cloud Run / Vercel URL in production.
VITE_API_BASE=http://localhost:8000

# How the video is sent to the backend:
#   direct = POST the file straight to the backend (Cloud Run / any real server)
#   blob   = upload to Vercel Blob first, send only the URL (REQUIRED on Vercel,
#            whose functions cap request bodies at 4.5 MB). Blob is deleted after analysis.
# Switch deploy targets by changing THIS value — no code changes.
VITE_UPLOAD_MODE=direct

# Only used in blob mode (Vercel Blob Node routes in /api of this project):
# VITE_BLOB_UPLOAD_ROUTE=/api/upload
# VITE_BLOB_DELETE_ROUTE=/api/cleanup
