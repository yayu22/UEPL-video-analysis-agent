# Copy to `.env` (which is git-ignored) and fill in your key. The backend reads these
# from the environment; backend/.env is auto-loaded via python-dotenv.

# REQUIRED — your Gemini API key (kept server-side only; never shipped to the browser).
GENAI_API_KEY=your_gemini_api_key_here

# OPTIONAL — model overrides (defaults match the deployed AFDD stack: gemini-2.5-flash).
# Recommended upgrade for cheaper audio + better accuracy (verify it's enabled on your key):
#   UEPL_BEHAVIOUR_MODEL=gemini-3.7-flash
#   UEPL_EQUIPMENT_MODEL=gemini-3.1-flash-lite
# UEPL_BEHAVIOUR_MODEL=gemini-2.5-flash
# UEPL_EQUIPMENT_MODEL=gemini-2.5-flash

# OPTIONAL — frame sampling rate (fps) per view. Higher = catches faster motion, costs more.
# UEPL_FRONT_FPS=5
# UEPL_CABIN_FPS=2
# UEPL_EQUIPMENT_FPS=1

# OPTIONAL — API server.
# UEPL_CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com
# UEPL_MAX_UPLOAD_BYTES=524288000
